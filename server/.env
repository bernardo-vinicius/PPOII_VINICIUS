# URL de conexão com o banco de dados local(SQLite)
# Mude para o url do seu banco
DATABASE_URL="file:./prisma/dev.db"

# Chave secreta para assinar os JSON Web Tokens
JWT_SECRET="CHAVE_SECRETA_E_ALEATORIA_AQUI"

# Porta em que o servidor irá rodar local( no caso sera a porta interna do docker)
PORT=5000